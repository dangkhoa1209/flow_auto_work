{
  "name": "flow_auto_work",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flow Auto WorkBench — GitLab issues → Cursor SDK local auto-work via UI",
  "scripts": {
    "dev": "nodemon",
    "dev:web": "npm run dev --prefix web",
    "dev:all": "npm run dev & npm run dev:web",
    "build:web": "npm run build --prefix web",
    "start": "tsx src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "npm run build --prefix web --if-present",
    "selfcheck": "tsx scripts/selfcheck.ts",
    "list-tasks": "tsx scripts/list-tasks.ts list",
    "scan": "tsx scripts/list-tasks.ts scan",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:8787"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.18",
    "@hono/node-server": "^2.0.11",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "hono": "^4.12.31",
    "mongodb": "^7.5.0",
    "morgan": "^1.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
