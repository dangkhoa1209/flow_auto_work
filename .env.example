# Server
PORT=8787
HOST=127.0.0.1

# REQUIRED — encrypt user GitLab/Cursor tokens at rest (AES-256-GCM)
# Generate: openssl rand -hex 32
FLOW_SECRETS_KEY=

GITLAB_BASE_URL=https://gitlab.com

# MongoDB
DB_HOST=127.0.0.1
DB_PORT=27017
DB_DATABASE=flow_auto_work
# Optional auth
# DB_USERNAME=
# DB_PASSWORD=

# Skip listing issues with these labels (comma-separated, case-insensitive)
SKIP_LABELS=auto-work:skip,wip-human
# Max clarify Q&A rounds before job fails
MAX_CLARIFY_ROUNDS=3
# Clarify UI wait timeout (minutes). Name is legacy from Teams.
TEAMS_CLARIFY_TIMEOUT_MIN=60

# Keep false unless you want auto enqueue on boot
STARTUP_SCAN=false
STARTUP_SCAN_INCLUDE_SUCCEEDED=false

# Optional handoff UI defaults (Done chờ)
# ON_COMPLETE_ASSIGN_USERNAMES=
# ON_COMPLETE_LABELS=
# ON_COMPLETE_COMMENT=
