# Server
PORT=8787
HOST=127.0.0.1
# NODE_ENV=production
# Comma-separated Vue UI origins for CORS (default: Vite 5173 + API 8787)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787
# Rate limit: window ms / max reqs per IP on /api (0 = disable). SSE /events skipped.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300

# REQUIRED — encrypt user GitLab/Cursor tokens at rest (AES-256-GCM)
# Generate: openssl rand -hex 32
FLOW_SECRETS_KEY=

GITLAB_BASE_URL=https://gitlab.com

# MongoDB
DB_HOST=127.0.0.1
DB_PORT=27017
DB_DATABASE=flow_auto_work
# Optional auth
# DB_USERNAME=
# DB_PASSWORD=

# Skip listing issues with these labels (comma-separated, case-insensitive)
SKIP_LABELS=auto-work:skip,wip-human
# Max clarify Q&A rounds before job fails
MAX_CLARIFY_ROUNDS=3
# Clarify UI wait timeout (minutes). Name is legacy from Teams.
TEAMS_CLARIFY_TIMEOUT_MIN=60

# Token budget per job (total tokens, 0 = unlimited). Blocks Run/Send when exceeded.
# JOB_TOKEN_BUDGET=0
# Verify command after code phase (per-project verifyCommand overrides this). Empty = skip.
# VERIFY_COMMAND=npm run typecheck
# VERIFY_TIMEOUT_SEC=300
# Auto-retry count for transient Cursor transport errors per agent call
# AGENT_TRANSIENT_RETRIES=2

# Keep false unless you want auto enqueue on boot
STARTUP_SCAN=false
STARTUP_SCAN_INCLUDE_SUCCEEDED=false

# Optional handoff UI defaults (Done chờ)
# ON_COMPLETE_ASSIGN_USERNAMES=
# ON_COMPLETE_LABELS=
# ON_COMPLETE_COMMENT=

# Auth: username/password (seed user khoadev). Bypass accepts any seeded user.
# AUTH_BYPASS_PASSWORD=
# Cloned repos root (default: <cwd>/project → project/{username}/{projectName}/source)
# PROJECT_ROOT=

# Internal Workbench PTY terminal (local only). Off by default.
# Requires HOST or client on loopback. Never enable on a public host.
# WORKBENCH_TERMINAL=1

# Google OAuth — read Sheets links in tasks (optional; leave empty to skip gate)
# Enable on the same Cloud project:
# - Google Sheets API: https://console.cloud.google.com/apis/library/sheets.googleapis.com
# - Google Drive API:  https://console.cloud.google.com/apis/library/drive.googleapis.com
# (Drive API needed for Excel/.xlsx uploaded to Drive — not native Sheets)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/api/google/callback

# Devops build runner — FIFO queue, concurrency forced to 1.
# Optional seed only (copied into Mongo when build_scripts is empty).
# After first boot, Devops thêm/sửa/xóa lệnh trên UI /devops.
# BUILD_SCRIPTS=[{"id":"ykkuat","label":"YKK UAT","command":"bash /opt/build/YKKUAT.sh","workingDir":"/opt/build","timeoutSec":1800}]
# BUILD_SCRIPTS_FILE=/etc/flow/build-scripts.json
# BUILD_LOG_DIR=
# BUILD_TIMEOUT_SEC=1800
# BUILD_KILL_GRACE_MS=8000
# BUILD_QUEUE_MAX=50
