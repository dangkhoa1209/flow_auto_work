# Ingest
INGEST_MODE=webhook
PORT=8787
HOST=127.0.0.1

# Cursor SDK (https://cursor.com/dashboard/integrations)
CURSOR_API_KEY=cursor_...
CURSOR_MODEL=composer-2.5

# Repo to work on
AIHR_REPO_PATH=/Users/dangkhoa/Developer/Work/Jobtest/aihr_v3
ALLOWED_PROJECT_PATH=kiemnv/aihr_v3
GITLAB_BASE_URL=https://gitlab.com
# Create at https://gitlab.com/-/user_settings/personal_access_tokens
# Scopes: api (read issues + create MR/comments)
GITLAB_TOKEN=glpat-PASTE_REAL_TOKEN_HERE
GITLAB_WEBHOOK_SECRET=pick-any-long-secret
# Exact GitLab username (profile URL: gitlab.com/<this>)
GITLAB_ASSIGNEE_USERNAME=khoahdjobtestvn
# Optional: numeric user id (checked in addition to username)
# GITLAB_ASSIGNEE_ID=
MR_TARGET_BRANCH=
# Optional comma-separated GitLab usernames for MR reviewers
# MR_REVIEWER_USERNAMES=

# Skip labels (comma-separated)
SKIP_LABELS=auto-work:skip,wip-human

# Teams clarify (Microsoft Graph — Azure app + admin consent)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
# Prefer chat id of your 1:1 chat with the bot/app identity
TEAMS_CHAT_ID=
# Or your Azure AD user object id (used to find/create 1:1 if TEAMS_CHAT_ID empty)
TEAMS_USER_ID=
TEAMS_CLARIFY_TIMEOUT_MIN=60
TEAMS_POLL_INTERVAL_SEC=20
MAX_CLARIFY_ROUNDS=3

# Job store
DATA_DIR=./data

# On start: also scan open issues already assigned to you (in addition to webhook)
STARTUP_SCAN=true
# Re-queue issues that already succeeded once (default false)
STARTUP_SCAN_INCLUDE_SUCCEEDED=false

# Never commit these (still tracked locally — NOT gitignore)
COMMIT_EXCLUDE_PATHS=resources/js/composables/permission.js,resources/js/directives/index.js
