# Server
INGEST_MODE=webhook
PORT=8787
HOST=127.0.0.1

# REQUIRED — encrypt user GitLab/Cursor tokens at rest (AES-256-GCM)
# Generate: openssl rand -hex 32
FLOW_SECRETS_KEY=

GITLAB_BASE_URL=https://gitlab.com
# Webhook HMAC (required even if WEBHOOK_AUTO_ENQUEUE=false)
GITLAB_WEBHOOK_SECRET=pick-any-long-secret

# Fallback model if user chưa chọn trên UI (Settings)
CURSOR_MODEL=auto

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=flow_auto_work

SKIP_LABELS=auto-work:skip,wip-human
MAX_CLARIFY_ROUNDS=3
# Clarify UI wait timeout (minutes). Name is legacy from Teams.
TEAMS_CLARIFY_TIMEOUT_MIN=60

# UI is primary — keep these false unless you want auto enqueue
STARTUP_SCAN=false
STARTUP_SCAN_INCLUDE_SUCCEEDED=false
WEBHOOK_AUTO_ENQUEUE=false

COMMIT_EXCLUDE_PATHS=resources/js/composables/permission.js,resources/js/directives/index.js

# ── Optional legacy .env defaults (prefer login + project trên UI) ──
# GITLAB_TOKEN=          # UI: {GITLAB_BASE_URL}/-/user_settings/personal_access_tokens (scope api)
# CURSOR_API_KEY=        # UI: https://cursor.com/dashboard?tab=integrations
# AIHR_REPO_PATH=        # local clone path (UI project)
# ALLOWED_PROJECT_PATH=  # e.g. group/project (UI project)
# GITLAB_ASSIGNEE_USERNAME=
# GITLAB_ASSIGNEE_ID=
# MR_TARGET_BRANCH=      # legacy default base branch (UI baseBranch preferred)

# Optional handoff UI defaults (Done chờ)
# ON_COMPLETE_ASSIGN_USERNAMES=
# ON_COMPLETE_LABELS=
# ON_COMPLETE_COMMENT=

# ── Dropped from example (code still accepts; not used by main UI flow) ──
# MR_REVIEWER_USERNAMES=   # only for createMergeRequest — never called anymore
# TEAMS_TENANT_ID=         # Teams clarify unused; clarify is in-app UI
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# TEAMS_CHAT_ID=
# TEAMS_USER_ID=
# TEAMS_POLL_INTERVAL_SEC=
