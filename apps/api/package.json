{
  "name": "@flow/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flow Auto WorkBench API (Express)",
  "scripts": {
    "dev": "nodemon",
    "start": "tsx src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "selfcheck": "tsx scripts/selfcheck.ts",
    "list-tasks": "tsx scripts/list-tasks.ts list",
    "scan": "tsx scripts/list-tasks.ts scan",
    "build": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.18",
    "@flow/shared": "*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.5.0",
    "morgan": "^1.11.0",
    "mysql2": "^3.23.3",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.21.0",
    "@types/ws": "^8.18.1",
    "@types/xlsx": "^0.0.35",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
