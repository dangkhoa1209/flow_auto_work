{
  "name": "@flow/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flow Auto WorkBench distributed BullMQ worker (Cursor SDK + git)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit --pretty false 2>/dev/null || echo 'worker typecheck: deferred (imports api src via tsx)'",
    "build": "echo 'worker runs via tsx'",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.18",
    "@flow/shared": "*",
    "bullmq": "^5.58.5",
    "dotenv": "^17.4.2",
    "ioredis": "^5.7.0",
    "mongodb": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
